<UserControl x:Class="WpfClient.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="20">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Створити замовлення"
                        Style="{StaticResource ActionButtonStyle}"
                        Visibility="{Binding CanManageOrders, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,0,8,0" />
                <Button Content="Оновити" Style="{StaticResource ActionButtonStyle}" />
            </StackPanel>

            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="120" />
                    <DataGridTextColumn Header="Клієнт" Binding="{Binding Customer}" Width="*" />
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150" />
                    <DataGridTextColumn Header="Сума" Binding="{Binding Total}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
