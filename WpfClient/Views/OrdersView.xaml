<UserControl x:Class="WpfClient.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WpfClient.Models">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*" />
            <ColumnDefinition Width="0.95*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="#D9E1EA"
                BorderThickness="1"
                CornerRadius="6"
                Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding Path=T[CreateOrder]}"
                                Command="{Binding BeginCreateOrderCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Visibility="{Binding CanManageOrders, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding Path=T[Refresh]}"
                                Command="{Binding RefreshDataCommand}"
                                Style="{StaticResource ActionButtonStyle}" />
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding OrderSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="34"
                                 Padding="8"
                                 Margin="0,0,8,0"
                                 ToolTip="{Binding Path=T[OrderSearchTip]}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding OrderStatusFilterOptions}"
                                  SelectedItem="{Binding OrderStatusFilter, Mode=TwoWay}"
                                  MinHeight="34"
                                  Padding="8"
                                  Margin="0,0,8,0" />
                        <Button Grid.Column="2"
                                Content="{Binding Path=T[Reset]}"
                                Command="{Binding ClearOrderFiltersCommand}"
                                Style="{StaticResource ActionButtonStyle}" />
                    </Grid>
                    <TextBlock Text="{Binding OrderFilterSummaryText}"
                               Foreground="#687789"
                               FontSize="12"
                               Margin="0,8,0,0" />

                    <Border Background="#FFF4E5"
                            BorderBrush="#F0B35B"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,12,0,0"
                            Visibility="{Binding HasApiError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ApiErrorMessage}"
                                   Foreground="#8A4B00"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          MouseDoubleClick="OrdersGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Path=[Number], Source={x:Static models:LocalizationManager.Instance}}" Binding="{Binding Number}" Width="115" />
                        <DataGridTextColumn Header="{Binding Path=[Date], Source={x:Static models:LocalizationManager.Instance}}" Binding="{Binding CreatedAtText}" Width="105" />
                        <DataGridTextColumn Header="{Binding Path=[Customer], Source={x:Static models:LocalizationManager.Instance}}" Binding="{Binding Customer}" Width="*" />
                        <DataGridTextColumn Header="{Binding Path=[Status], Source={x:Static models:LocalizationManager.Instance}}" Binding="{Binding StatusText}" Width="130" />
                        <DataGridTextColumn Header="{Binding Path=[Total], Source={x:Static models:LocalizationManager.Instance}}" Binding="{Binding TotalText}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1"
                Background="#FFFFFF"
                BorderBrush="#D9E1EA"
                BorderThickness="1"
                CornerRadius="6"
                Padding="20"
                Margin="16,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Path=T[OrderDetails]}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#17202B"
                               Margin="0,0,0,14" />

                    <TextBlock Text="{Binding Path=T[SelectOrder]}"
                               Foreground="#687789"
                               Visibility="{Binding HasSelectedOrder, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                        <StackPanel Visibility="{Binding HasSelectedOrderDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding CanManageOrders, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Content="{Binding Path=T[EditOrder]}"
                                    Command="{Binding OpenOrderEditorCommand}"
                                    Style="{StaticResource ActionButtonStyle}" />
                            <TextBlock Text="{Binding Path=T[OrderEditLimited]}"
                                       Foreground="#687789"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Visibility="{Binding IsSelectedOrderEditable, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding Path=T[Number]}" Foreground="#687789" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedOrderDetails.Number}" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Text="{Binding Path=T[Date]}" Foreground="#687789" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedOrderDetails.CreatedAtText}" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2" Text="{Binding Path=T[Customer]}" Foreground="#687789" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedOrderDetails.Customer}" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="3" Text="{Binding Path=T[Status]}" Foreground="#687789" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedOrderDetails.StatusText}" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="4" Text="{Binding Path=T[Total]}" Foreground="#687789" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedOrderDetails.TotalText}" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="5" Text="{Binding Path=T[Comment]}" Foreground="#687789" Margin="0,0,12,0" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedOrderDetails.Comment}" TextWrapping="Wrap" />
                        </Grid>

                        <StackPanel Margin="0,0,0,18"
                                    Visibility="{Binding HasAvailableOrderStatusActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding Path=T[StatusActions]}"
                                       FontWeight="SemiBold"
                                       Foreground="#17202B"
                                       Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Content="{Binding Path=T[Register]}"
                                        Command="{Binding ChangeOrderStatusCommand}"
                                        CommandParameter="register"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="{Binding CanRegisterOrder, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,8,8" />
                                <Button Content="{Binding Path=T[Grant]}"
                                        Command="{Binding ChangeOrderStatusCommand}"
                                        CommandParameter="grant"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="{Binding CanGrantOrder, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,8,8" />
                                <Button Content="{Binding Path=T[Ship]}"
                                        Command="{Binding ChangeOrderStatusCommand}"
                                        CommandParameter="ship"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="{Binding CanShipOrder, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,8,8" />
                                <Button Content="{Binding Path=T[Invoice]}"
                                        Command="{Binding ChangeOrderStatusCommand}"
                                        CommandParameter="invoice"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="{Binding CanInvoiceOrder, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,8,8" />
                                <Button Content="{Binding Path=T[Cancel]}"
                                        Command="{Binding ChangeOrderStatusCommand}"
                                        CommandParameter="cancel"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="{Binding CanCancelOrder, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding Path=T[StatusHistory]}"
                                   FontWeight="SemiBold"
                                   Foreground="#17202B"
                                   Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding SelectedOrderDetails.StatusHistory}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Path=[Date], Source={x:Static models:LocalizationManager.Instance}}" Binding="{Binding ChangedAtText}" Width="120" />
                                <DataGridTextColumn Header="{Binding Path=[FromStatus], Source={x:Static models:LocalizationManager.Instance}}" Binding="{Binding PreviousStatusText}" Width="115" />
                                <DataGridTextColumn Header="{Binding Path=[ToStatus], Source={x:Static models:LocalizationManager.Instance}}" Binding="{Binding NewStatusText}" Width="115" />
                                <DataGridTextColumn Header="{Binding Path=[User], Source={x:Static models:LocalizationManager.Instance}}" Binding="{Binding ChangedBy}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
