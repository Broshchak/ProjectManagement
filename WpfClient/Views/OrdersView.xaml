<UserControl x:Class="WpfClient.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*" />
            <ColumnDefinition Width="0.95*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="#D9E1EA"
                BorderThickness="1"
                CornerRadius="6"
                Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Створити замовлення"
                                Command="{Binding BeginCreateOrderCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Visibility="{Binding CanManageOrders, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,0,8,0" />
                        <Button Content="Оновити"
                                Command="{Binding RefreshDataCommand}"
                                Style="{StaticResource ActionButtonStyle}" />
                    </StackPanel>

                    <Border Background="#FFF4E5"
                            BorderBrush="#F0B35B"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,12,0,0"
                            Visibility="{Binding HasApiError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ApiErrorMessage}"
                                   Foreground="#8A4B00"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          MouseDoubleClick="OrdersGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="115" />
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAtText}" Width="105" />
                        <DataGridTextColumn Header="Клієнт" Binding="{Binding Customer}" Width="*" />
                        <DataGridTextColumn Header="Стан" Binding="{Binding Status}" Width="130" />
                        <DataGridTextColumn Header="Сума" Binding="{Binding TotalText}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1"
                Background="#FFFFFF"
                BorderBrush="#D9E1EA"
                BorderThickness="1"
                CornerRadius="6"
                Padding="20"
                Margin="16,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Деталі замовлення"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#17202B"
                               Margin="0,0,0,14" />

                    <TextBlock Text="Оберіть замовлення у списку"
                               Foreground="#687789"
                               Visibility="{Binding HasSelectedOrder, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                        <StackPanel Visibility="{Binding HasSelectedOrderDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding CanManageOrders, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Content="Редагувати замовлення"
                                    Command="{Binding OpenOrderEditorCommand}"
                                    Style="{StaticResource ActionButtonStyle}" />
                            <TextBlock Text="Редагування доступне тільки для нових і зареєстрованих замовлень"
                                       Foreground="#687789"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Visibility="{Binding IsSelectedOrderEditable, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Номер" Foreground="#687789" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedOrderDetails.Number}" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Text="Дата" Foreground="#687789" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedOrderDetails.CreatedAtText}" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2" Text="Клієнт" Foreground="#687789" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedOrderDetails.Customer}" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="3" Text="Стан" Foreground="#687789" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedOrderDetails.Status}" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="4" Text="Сума" Foreground="#687789" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedOrderDetails.TotalText}" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="5" Text="Коментар" Foreground="#687789" Margin="0,0,12,0" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedOrderDetails.Comment}" TextWrapping="Wrap" />
                        </Grid>

                        <StackPanel Margin="0,0,0,18"
                                    Visibility="{Binding HasAvailableOrderStatusActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Дії зі станом"
                                       FontWeight="SemiBold"
                                       Foreground="#17202B"
                                       Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Content="Зареєструвати"
                                        Command="{Binding ChangeOrderStatusCommand}"
                                        CommandParameter="register"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="{Binding CanRegisterOrder, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,8,8" />
                                <Button Content="Погодити"
                                        Command="{Binding ChangeOrderStatusCommand}"
                                        CommandParameter="grant"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="{Binding CanGrantOrder, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,8,8" />
                                <Button Content="Відправити"
                                        Command="{Binding ChangeOrderStatusCommand}"
                                        CommandParameter="ship"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="{Binding CanShipOrder, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,8,8" />
                                <Button Content="Виставити рахунок"
                                        Command="{Binding ChangeOrderStatusCommand}"
                                        CommandParameter="invoice"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="{Binding CanInvoiceOrder, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,8,8" />
                                <Button Content="Скасувати"
                                        Command="{Binding ChangeOrderStatusCommand}"
                                        CommandParameter="cancel"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="{Binding CanCancelOrder, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>

                        <TextBlock Text="Історія станів"
                                   FontWeight="SemiBold"
                                   Foreground="#17202B"
                                   Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding SelectedOrderDetails.StatusHistory}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding ChangedAtText}" Width="120" />
                                <DataGridTextColumn Header="Зі стану" Binding="{Binding PreviousStatus}" Width="95" />
                                <DataGridTextColumn Header="У стан" Binding="{Binding NewStatus}" Width="95" />
                                <DataGridTextColumn Header="Користувач" Binding="{Binding ChangedBy}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
