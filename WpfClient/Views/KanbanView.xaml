<UserControl x:Class="WpfClient.Views.KanbanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewMouseLeftButtonDown="BoardMousePressed"
             PreviewMouseLeftButtonUp="BoardMouseReleased"
             PreviewMouseMove="BoardMouseMoved">
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#FFFFFF"
                BorderBrush="#D9E1EA"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding KanbanSearchText, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="34"
                         Padding="8"
                         Margin="0,0,8,0"
                         ToolTip="{Binding Path=T[OrderSearchTip]}" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding OrderStatusFilterOptions}"
                          DisplayMemberPath="Name" SelectedValuePath="Code"
                          SelectedValue="{Binding KanbanStatusFilter, Mode=TwoWay}"
                          MinHeight="34"
                          Padding="8"
                          Margin="0,0,8,0" />
                <Button Grid.Column="2"
                        Content="{Binding Path=T[Reset]}"
                        Command="{Binding ClearKanbanFiltersCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Grid.Column="3"
                        Content="{Binding Path=T[Refresh]}"
                        Command="{Binding RefreshDataCommand}"
                        Style="{StaticResource ActionButtonStyle}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding T[KanbanDragHint]}" Foreground="#526377" TextWrapping="Wrap"/>
            <Border Background="#EEF4FC" BorderBrush="#CFDEEF" BorderThickness="1" CornerRadius="6" Padding="10,7"
                    Margin="0,6,0,0" Visibility="{Binding HasKanbanMoveMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding KanbanMoveMessage}" Foreground="#25496E" TextWrapping="Wrap"/>
            </Border>
            <TextBlock Text="{Binding ApiErrorMessage}" Foreground="#A32932" TextWrapping="Wrap" Margin="0,5,0,0"
                       Visibility="{Binding HasApiError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      AllowDrop="True" PreviewDragOver="BoardDragOver">
            <ItemsControl ItemsSource="{Binding KanbanColumns}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="245"
                                MinHeight="200"
                                AllowDrop="True"
                                DragEnter="ColumnDragOver"
                                DragOver="ColumnDragOver"
                                Drop="ColumnDropped"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,12,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#D9E1EA"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                            <Setter Property="Background" Value="#EDF5FF"/>
                                            <Setter Property="BorderBrush" Value="#4A84C5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Border Background="{Binding Color}" Height="3" CornerRadius="1.5" Margin="0,0,0,9"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   ToolTip="{Binding Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Foreground="#17202B" />
                                        <Border Grid.Column="1"
                                                Background="#EAF2FF"
                                                CornerRadius="6"
                                                Padding="8,3">
                                            <TextBlock Text="{Binding Count}"
                                                       Foreground="#255C99"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding TotalText}"
                                               Foreground="#687789"
                                               FontSize="12"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.T[KanbanEmptyColumn], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Foreground="#687789" TextWrapping="Wrap" Padding="4,12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Orders}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F8FAFC"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="10"
                                                            Margin="0,0,0,10"
                                                            PreviewMouseLeftButtonDown="CardMousePressed">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Number}"
                                                                           ToolTip="{Binding Number}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,0,8,0"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#17202B" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding TotalText}"
                                                                           Foreground="#255C99"
                                                                           FontWeight="SemiBold" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding Customer}"
                                                                       Foreground="#3B4754"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,6,0,0" />
                                                            <TextBlock Text="{Binding CreatedAtText}"
                                                                       Foreground="#687789"
                                                                       FontSize="12"
                                                                       Margin="0,6,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
