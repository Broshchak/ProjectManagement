<Window x:Class="WpfClient.Views.KanbanMoveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding T[KanbanMoveTitle]}" Width="465" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="#F5F7FA">
    <Border Background="White" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="8" Margin="16" Padding="20">
        <StackPanel>
            <TextBlock Text="{Binding Destination}" FontSize="20" FontWeight="SemiBold" Foreground="#173D68" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding T[KanbanChooseAction]}" Foreground="#526377" Margin="0,12,0,4"/>
            <ComboBox x:Name="ActionPicker" ItemsSource="{Binding Actions}" DisplayMemberPath="Name" MinHeight="34"
                      Padding="7,4" SelectionChanged="InputChanged"/>
            <TextBlock x:Name="CommentLabel" Foreground="#526377" Margin="0,12,0,4"/>
            <TextBox x:Name="CommentInput" MaxLength="1000" MinHeight="74" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8" TextChanged="InputChanged"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{Binding T[Cancel]}" IsCancel="True" Style="{StaticResource ActionButtonStyle}"
                        Background="#526377" BorderBrush="#526377" Margin="0,0,8,0"/>
                <Button x:Name="ConfirmButton" Content="{Binding T[KanbanMoveSubmit]}" IsDefault="True"
                        Style="{StaticResource ActionButtonStyle}" Click="ConfirmClicked"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
