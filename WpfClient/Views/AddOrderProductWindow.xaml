<Window x:Class="WpfClient.Views.AddOrderProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Додати товар"
        Width="760"
        Height="520"
        MinWidth="640"
        MinHeight="420"
        Background="#F5F7FA"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Доступні товари"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#17202B"
                       Margin="0,0,0,10" />
            <TextBox x:Name="SearchBox"
                     MinHeight="32"
                     TextChanged="SearchBox_TextChanged" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#D9E1EA"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <DataGrid x:Name="ProductsGrid"
                      ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedOrderItemProduct, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      MouseDoubleClick="ProductsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Категорія" Binding="{Binding Category}" Width="160" />
                    <DataGridTextColumn Header="Ціна" Binding="{Binding PriceText}" Width="120" />
                    <DataGridTextColumn Header="Залишок" Binding="{Binding Quantity}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Кількість" Foreground="#687789" />
                <TextBox Text="{Binding OrderItemQuantity, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         MinHeight="32" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Додати"
                    Style="{StaticResource ActionButtonStyle}"
                    VerticalAlignment="Bottom"
                    Click="AddButton_Click" />

            <TextBlock Grid.Column="2"
                       Text="{Binding OrderItemEditorError}"
                       Foreground="#B42318"
                       TextWrapping="Wrap"
                       VerticalAlignment="Bottom"
                       Margin="12,0,0,7"
                       Visibility="{Binding HasOrderItemEditorError, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <Button Grid.Row="3"
                Content="Закрити"
                Width="110"
                HorizontalAlignment="Right"
                Style="{StaticResource ActionButtonStyle}"
                Margin="0,14,0,0"
                Click="CloseButton_Click" />
    </Grid>
</Window>
