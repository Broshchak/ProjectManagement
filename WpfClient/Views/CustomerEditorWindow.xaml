<Window x:Class="WpfClient.Views.CustomerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WpfClient.Models"
        Title="{Binding Path=[Customer], Source={x:Static models:LocalizationManager.Instance}}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel x:Name="Form" Margin="20">
        <TextBlock Text="{Binding Path=[FullName], Source={x:Static models:LocalizationManager.Instance}}" />
        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" MinHeight="32" Margin="0,4,0,12" />
        <TextBlock Text="{Binding Path=[Phone], Source={x:Static models:LocalizationManager.Instance}}" />
        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" MinHeight="32" Margin="0,4,0,12" />
        <TextBlock Text="Email" />
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="160" MinHeight="32" Margin="0,4,0,12" />
        <TextBlock Text="{Binding Path=[Address], Source={x:Static models:LocalizationManager.Instance}}" />
        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" MinHeight="64" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,12" />
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#B42318" Margin="0,0,0,12" />
        <Button Content="{Binding Path=[Save], Source={x:Static models:LocalizationManager.Instance}}"
                Style="{StaticResource ActionButtonStyle}" Click="Save_Click" />
    </StackPanel>
</Window>
