<UserControl x:Class="WpfClient.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Path=T[ReportsTitle]}" FontSize="18" FontWeight="SemiBold" Foreground="#17202B" />
                    <TextBlock Text="{Binding Path=T[ReportsDescription]}"
                               TextWrapping="Wrap"
                               Foreground="#687789"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Від:" VerticalAlignment="Center" Foreground="#687789" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding ReportDateFrom}" Width="130" Margin="0,0,10,0" />
                    <TextBlock Text="До:" VerticalAlignment="Center" Foreground="#687789" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding ReportDateTo}" Width="130" Margin="0,0,12,0" />
                    <Button Content="Оновити звіти"
                            Command="{Binding RefreshReportsCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Visibility="{Binding CanViewReports, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,0,8,0" />
                    <Button Content="Зберегти PDF"
                            Command="{Binding ExportReportsToPdfCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Visibility="{Binding CanViewReports, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedReportTabIndex}">
            <TabItem Header="Зведення">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,14,0,0">
                        <UniformGrid Columns="4">
                            <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Замовлень" Foreground="#687789" />
                                    <TextBlock Text="{Binding Summary.TotalOrders}" FontSize="26" FontWeight="SemiBold" Foreground="#17202B" />
                                </StackPanel>
                            </Border>
                            <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Сума" Foreground="#687789" />
                                    <TextBlock Text="{Binding Summary.TotalAmountText}" FontSize="22" FontWeight="SemiBold" Foreground="#17202B" />
                                </StackPanel>
                            </Border>
                            <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Середній чек" Foreground="#687789" />
                                    <TextBlock Text="{Binding Summary.AverageOrderAmountText}" FontSize="22" FontWeight="SemiBold" Foreground="#17202B" />
                                </StackPanel>
                            </Border>
                            <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Низькі залишки" Foreground="#687789" />
                                    <TextBlock Text="{Binding Summary.LowStockProducts}" FontSize="26" FontWeight="SemiBold" Foreground="#B45309" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Статуси замовлень" FontSize="16" FontWeight="SemiBold" Foreground="#17202B" />
                                    <UniformGrid Columns="3" Margin="0,12,0,0">
                                        <StackPanel Margin="0,0,12,10">
                                            <TextBlock Text="Нові" Foreground="#687789" />
                                            <TextBlock Text="{Binding Summary.NewOrders}" FontSize="22" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,10">
                                            <TextBlock Text="В роботі" Foreground="#687789" />
                                            <TextBlock Text="{Binding Summary.OrdersInProgress}" FontSize="22" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,10">
                                            <TextBlock Text="Відвантажені" Foreground="#687789" />
                                            <TextBlock Text="{Binding Summary.ShippedOrders}" FontSize="22" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Рахунки" Foreground="#687789" />
                                            <TextBlock Text="{Binding Summary.InvoicedOrders}" FontSize="22" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Скасовані" Foreground="#687789" />
                                            <TextBlock Text="{Binding Summary.CancelledOrders}" FontSize="22" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="22,0,0,0">
                                    <TextBlock Text="Звіт для керівника" FontSize="16" FontWeight="SemiBold" Foreground="#17202B" />
                                    <TextBlock Text="{Binding ReportPeriodText}" Foreground="#687789" Margin="0,4,0,0" />
                                    <TextBox Text="{Binding ManagerReportText, Mode=OneWay}"
                                             Margin="0,12,0,0"
                                             Padding="10"
                                             MinHeight="150"
                                             TextWrapping="Wrap"
                                             IsReadOnly="True"
                                             VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="За дату">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Дата:" VerticalAlignment="Center" Foreground="#687789" Margin="0,0,8,0" />
                            <DatePicker SelectedDate="{Binding TodayReportDate}" Width="150" Margin="0,0,12,0" />
                            <Button Content="Показати"
                                    Command="{Binding RefreshReportsCommand}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Margin="0,0,18,0" />
                            <TextBlock Text="{Binding TodayReportSummaryText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#17202B" />
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding TodayReportOrders}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" Binding="{Binding OrderNumber}" Width="120" />
                            <DataGridTextColumn Header="Клієнт" Binding="{Binding CustomerFullName}" Width="*" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="140" />
                            <DataGridTextColumn Header="Сума" Binding="{Binding TotalAmountText}" Width="130" />
                            <DataGridTextColumn Header="Створено" Binding="{Binding CreatedAtText}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Товари">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding ReportPeriodText}" Foreground="#687789" Margin="0,0,0,8" />
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ProductSalesReport}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="Категорія" Binding="{Binding CategoryName}" Width="180" />
                            <DataGridTextColumn Header="Кількість" Binding="{Binding Quantity}" Width="100" />
                            <DataGridTextColumn Header="Сума" Binding="{Binding TotalAmountText}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Низькі залишки">
                <DataGrid ItemsSource="{Binding LowStockReport}"
                          Margin="0,14,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="Категорія" Binding="{Binding CategoryName}" Width="180" />
                        <DataGridTextColumn Header="Залишок" Binding="{Binding Quantity}" Width="100" />
                        <DataGridTextColumn Header="Ціна" Binding="{Binding PriceText}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
