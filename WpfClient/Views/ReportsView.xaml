<UserControl x:Class="WpfClient.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="20">
        <StackPanel>
            <TextBlock Text="Звіти для керівника" FontSize="18" FontWeight="SemiBold" Foreground="#17202B" />
            <TextBlock Text="Тут буде перегляд статистики замовлень і підготовка даних, які Telegram-бот надсилатиме керівнику."
                       TextWrapping="Wrap"
                       Foreground="#687789"
                       Margin="0,8,0,18" />
            <Button Content="Сформувати звіт"
                    Style="{StaticResource ActionButtonStyle}"
                    Visibility="{Binding CanViewReports, Converter={StaticResource BooleanToVisibilityConverter}}"
                    HorizontalAlignment="Left" />
        </StackPanel>
    </Border>
</UserControl>
