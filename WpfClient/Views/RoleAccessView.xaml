<UserControl x:Class="WpfClient.Views.RoleAccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Text="{Binding Error}" Foreground="#A32932" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Grid IsEnabled="{Binding IsIdle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <Button Content="{Binding T[Refresh]}" Command="{Binding RefreshCommand}" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" MinHeight="200" MaxHeight="350">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Code}" Foreground="#546474"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding T[RoleCode]}" Margin="0,12,0,2"/>
                    <TextBox Text="{Binding NewCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"/>
                    <TextBlock Text="{Binding T[RoleName]}" Margin="0,8,0,2"/>
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
                    <Button Content="{Binding T[RoleCreate]}" Command="{Binding CreateCommand}" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding SelectedRole.Code}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding RoleStatus}" Foreground="#546474" Margin="0,2,0,8"/>
                    <TextBlock Text="{Binding T[RoleName]}" Margin="0,4,0,2"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
                    <WrapPanel Margin="0,8,0,16">
                        <Button Content="{Binding T[RoleRename]}" Command="{Binding RenameCommand}" Margin="0,0,8,0"/>
                        <Button Content="{Binding ToggleLabel}" Command="{Binding ToggleActiveCommand}" Margin="0,0,8,0"/>
                        <Button Content="{Binding T[RoleDelete]}" Command="{Binding DeleteCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding T[RoleVisibility]}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding T[RoleVisibilityHint]}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <ItemsControl ItemsSource="{Binding Choices}" IsEnabled="{Binding CanEditVisibility}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding Enabled}" Margin="0,0,0,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button HorizontalAlignment="Left" Content="{Binding T[RoleSaveVisibility]}" Command="{Binding SaveVisibilityCommand}" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
