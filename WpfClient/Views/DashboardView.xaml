<UserControl x:Class="WpfClient.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Columns="4" Margin="0,0,0,20">
            <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Нові" Foreground="#687789" />
                    <TextBlock Text="{Binding Summary.NewOrders}" FontSize="30" FontWeight="SemiBold" Foreground="#17202B" />
                </StackPanel>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="В роботі" Foreground="#687789" />
                    <TextBlock Text="{Binding Summary.OrdersInProgress}" FontSize="30" FontWeight="SemiBold" Foreground="#17202B" />
                </StackPanel>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Відправлені" Foreground="#687789" />
                    <TextBlock Text="{Binding Summary.ShippedOrders}" FontSize="30" FontWeight="SemiBold" Foreground="#17202B" />
                </StackPanel>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="18">
                <StackPanel>
                    <TextBlock Text="Оплачені" Foreground="#687789" />
                    <TextBlock Text="{Binding Summary.InvoicedOrders}" FontSize="30" FontWeight="SemiBold" Foreground="#17202B" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="20">
            <StackPanel>
                <TextBlock Text="Поточний стан клієнта" FontSize="18" FontWeight="SemiBold" Foreground="#17202B" />
                <TextBlock Text="{Binding LoadingStatusText}"
                           TextWrapping="Wrap"
                           Foreground="#687789"
                           Margin="0,8,0,0" />
                <TextBlock Text="{Binding ApiErrorMessage}"
                           TextWrapping="Wrap"
                           Foreground="#9B1C1C"
                           Margin="0,8,0,0"
                           Visibility="{Binding HasApiError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
