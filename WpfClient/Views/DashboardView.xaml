<UserControl x:Class="WpfClient.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Columns="4" Margin="0,0,0,20">
            <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{Binding Path=T[TotalOrders]}" Foreground="#687789" />
                    <TextBlock Text="{Binding Summary.TotalOrders}" FontSize="30" FontWeight="SemiBold" Foreground="#17202B" />
                </StackPanel>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{Binding Path=T[TotalAmount]}" Foreground="#687789" />
                    <TextBlock Text="{Binding Summary.TotalAmountText}" FontSize="25" FontWeight="SemiBold" Foreground="#17202B" />
                </StackPanel>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{Binding Path=T[AverageCheck]}" Foreground="#687789" />
                    <TextBlock Text="{Binding Summary.AverageOrderAmountText}" FontSize="25" FontWeight="SemiBold" Foreground="#17202B" />
                </StackPanel>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="18">
                <StackPanel>
                    <TextBlock Text="{Binding Path=T[LowStockPlural]}" Foreground="#687789" />
                    <TextBlock Text="{Binding Summary.LowStockProducts}" FontSize="30" FontWeight="SemiBold" Foreground="#B45309" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Path=T[ClientState]}" FontSize="18" FontWeight="SemiBold" Foreground="#17202B" />
                <TextBlock Text="{Binding LoadingStatusText}"
                           TextWrapping="Wrap"
                           Foreground="#687789"
                           Margin="0,8,0,0" />
                <TextBlock Text="{Binding ApiErrorMessage}"
                           TextWrapping="Wrap"
                           Foreground="#9B1C1C"
                           Margin="0,8,0,0"
                           Visibility="{Binding HasApiError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding Path=T[OrderStatuses]}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#17202B"
                               Margin="0,22,0,10" />
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="{Binding Path=T[NewOrders]}" Foreground="#687789" />
                            <TextBlock Text="{Binding Summary.NewOrders}" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="{Binding Path=T[InProgress]}" Foreground="#687789" />
                            <TextBlock Text="{Binding Summary.OrdersInProgress}" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="{Binding Path=T[Shipped]}" Foreground="#687789" />
                            <TextBlock Text="{Binding Summary.ShippedOrders}" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="{Binding Path=T[Invoiced]}" Foreground="#687789" />
                            <TextBlock Text="{Binding Summary.InvoicedOrders}" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="{Binding Path=T[Cancelled]}" Foreground="#687789" />
                            <TextBlock Text="{Binding Summary.CancelledOrders}" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="28,0,0,0">
                    <TextBlock Text="{Binding Path=T[Analytics]}" FontSize="18" FontWeight="SemiBold" Foreground="#17202B" />
                    <Border Background="#F8FAFC" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Path=T[TopProduct]}" Foreground="#687789" />
                            <TextBlock Text="{Binding Summary.TopProductText}" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" Foreground="#17202B" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#FFF7ED"
                            BorderBrush="#FDBA74"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,12,0,0"
                            Cursor="Hand"
                            Visibility="{Binding HasLowStockProducts, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenLowStockProductsCommand}" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="{Binding Path=T[Stock]}" Foreground="#9A3412" />
                            <TextBlock Text="{Binding Summary.LowStockProductsText}" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" Foreground="#7C2D12" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
