<Window x:Class="WpfClient.Views.CustomerSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WpfClient.Models"
        Title="{Binding Path=T[CustomerSelection]}"
        Width="720"
        Height="460"
        MinWidth="620"
        MinHeight="380"
        Background="#F5F7FA"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Path=T[Customers]}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#17202B"
                       Margin="0,0,0,10" />
            <TextBox x:Name="SearchBox"
                     MinHeight="32"
                     TextChanged="SearchBox_TextChanged" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#D9E1EA"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <DataGrid x:Name="CustomersGrid"
                      ItemsSource="{Binding Customers}"
                      SelectedItem="{Binding SelectedOrderCustomer, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      MouseDoubleClick="CustomersGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Path=[Customer], Source={x:Static models:LocalizationManager.Instance}}" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn Header="{Binding Path=[Phone], Source={x:Static models:LocalizationManager.Instance}}" Binding="{Binding Phone}" Width="150" />
                    <DataGridTextColumn Header="{Binding Path=[Email], Source={x:Static models:LocalizationManager.Instance}}" Binding="{Binding Email}" Width="220" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="{Binding Path=T[Choose]}"
                    Width="110"
                    Style="{StaticResource ActionButtonStyle}"
                    Margin="0,0,8,0"
                    Click="SelectButton_Click" />
            <Button Content="{Binding Path=T[Close]}"
                    Width="110"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
