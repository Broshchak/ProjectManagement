<UserControl x:Class="WpfClient.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WpfClient.Models">
    <Grid>
        <TextBlock Text="{Binding UsersUnavailableText}" TextWrapping="Wrap" Margin="20"
                   Visibility="{Binding IsUserManagementAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
    <Grid Visibility="{Binding IsUserManagementAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="#D9E1EA"
                BorderThickness="1"
                CornerRadius="6"
                Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="{Binding Path=T[AddUser]}"
                            Command="{Binding BeginAddUserCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,0,8,0" />
                    <Button Content="{Binding Path=T[Edit]}"
                            Command="{Binding BeginEditUserCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Path=[Login], Source={x:Static models:LocalizationManager.Instance}}" Binding="{Binding Login}" Width="130" />
                        <DataGridTextColumn Header="{Binding Path=[FullName], Source={x:Static models:LocalizationManager.Instance}}" Binding="{Binding FullName}" Width="*" />
                        <DataGridTextColumn Header="{Binding Path=[Role], Source={x:Static models:LocalizationManager.Instance}}" Binding="{Binding RoleName}" Width="110" />
                        <DataGridTemplateColumn Header="{Binding Path=[Active], Source={x:Static models:LocalizationManager.Instance}}" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center">
                                        <Ellipse Width="10"
                                                 Height="10">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#C8D1DC" />
                                                    <Setter Property="ToolTip" Value="{Binding Path=[UserInactiveTip], Source={x:Static models:LocalizationManager.Instance}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Fill" Value="#16A34A" />
                                                            <Setter Property="ToolTip" Value="{Binding Path=[UserActiveTip], Source={x:Static models:LocalizationManager.Instance}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="TG" Width="58">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center">
                                        <Ellipse Width="10"
                                                 Height="10">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#C8D1DC" />
                                                    <Setter Property="ToolTip" Value="{Binding Path=[TelegramInactiveTip], Source={x:Static models:LocalizationManager.Instance}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TelegramActive}" Value="True">
                                                            <Setter Property="Fill" Value="#16A34A" />
                                                            <Setter Property="ToolTip" Value="{Binding Path=[TelegramActiveTip], Source={x:Static models:LocalizationManager.Instance}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Telegram ID" Binding="{Binding TelegramUserIdText}" Width="125" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1"
                Background="#FFFFFF"
                BorderBrush="#D9E1EA"
                BorderThickness="1"
                CornerRadius="6"
                Padding="20"
                Width="340"
                Margin="16,0,0,0"
                Visibility="{Binding IsUserEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsUserEditorEnabled}">
                <StackPanel>
                    <TextBlock Text="{Binding UserEditorTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#17202B"
                               Margin="0,0,0,16" />

                    <TextBlock Text="{Binding Path=T[Login]}" Foreground="#3B4754" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding UserLogin, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="34"
                             Padding="8"
                             Margin="0,0,0,12" />

                    <TextBlock Text="{Binding Path=T[FullName]}" Foreground="#3B4754" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding UserFullName, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="34"
                             Padding="8"
                             Margin="0,0,0,12" />

                    <TextBlock Text="{Binding Path=T[Role]}" Foreground="#3B4754" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding RoleOptions}"
                              SelectedItem="{Binding UserRoleName, Mode=TwoWay}"
                              MinHeight="34"
                              Padding="8"
                              Margin="0,0,0,12" />

                    <TextBlock Text="{Binding Path=T[Password]}" Foreground="#3B4754" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <PasswordBox x:Name="UserPasswordInput" PasswordChanged="UserPasswordInput_PasswordChanged"
                                 MinHeight="34" Padding="8" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Path=T[PasswordSeparate]}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding IsEditingUser, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="{Binding Path=T[ChangePassword]}" Command="{Binding ChangeUserPasswordCommand}"
                            Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,12"
                            Visibility="{Binding IsEditingUser, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <CheckBox Content="{Binding Path=T[AccountActive]}"
                              IsChecked="{Binding UserIsActive}"
                              Margin="0,0,0,12" />

                    <CheckBox Content="{Binding Path=T[AllowTelegram]}"
                              IsChecked="{Binding UserTelegramAllowed}"
                              Margin="0,0,0,8" />

                    <TextBlock Text="Telegram User ID" Foreground="#3B4754" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding UserTelegramUserId, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="34"
                             Padding="8"
                             Margin="0,0,0,14" />

                    <Border Background="#FDECEC"
                            BorderBrush="#F5B5B5"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,14"
                            Visibility="{Binding HasUserEditorError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding UserEditorError}"
                                   Foreground="#9B1C1C"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding Path=T[Save]}"
                                Command="{Binding SaveUserCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding Path=T[Cancel]}"
                                Command="{Binding CancelUserEditCommand}"
                                Style="{StaticResource ActionButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
    </Grid>
</UserControl>
