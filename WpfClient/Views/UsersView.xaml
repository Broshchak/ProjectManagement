<UserControl x:Class="WpfClient.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="20">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Додати користувача"
                        Style="{StaticResource ActionButtonStyle}"
                        Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,0,8,0" />
                <Button Content="Змінити роль"
                        Style="{StaticResource ActionButtonStyle}"
                        Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Логін" Binding="{Binding Login}" Width="160" />
                    <DataGridTextColumn Header="ПІБ" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="160" />
                    <DataGridCheckBoxColumn Header="Активний" Binding="{Binding IsActive}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
