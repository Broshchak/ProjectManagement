<Window x:Class="WpfClient.Views.OrderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WpfClient.Models"
        Title="{Binding Path=T[EditOrder]}"
        Width="900"
        Height="580"
        MinWidth="760"
        MinHeight="500"
        Background="#F5F7FA"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20" IsEnabled="{Binding IsOrderEditorEnabled}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
            <StackPanel Visibility="{Binding IsEditingOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding SelectedOrderDetails.Number}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#17202B" />
                <TextBlock Text="{Binding SelectedOrderDetails.Customer}"
                           Foreground="#687789"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Grid Visibility="{Binding IsCreatingOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Path=T[Number]}" Foreground="#687789" />
                    <TextBox Text="{Binding OrderNumber, Mode=OneWay}"
                             MinHeight="32"
                             IsReadOnly="True"
                             Background="#F3F6FA"
                             VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Path=T[Customer]}" Foreground="#687789" />
                    <Border Background="#FFFFFF"
                            BorderBrush="#D9E1EA"
                            BorderThickness="1"
                            MinHeight="32"
                            Padding="8,0">
                        <TextBlock Text="{Binding SelectedOrderCustomer.DisplayName, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="2"
                        Content="{Binding Path=T[Choose]}"
                        Command="{Binding OpenSelectOrderCustomerCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        VerticalAlignment="Bottom" />
            </Grid>

            <Border DockPanel.Dock="Right"
                    Background="#EAF2FF"
                    Padding="12,7"
                    CornerRadius="6"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsEditingOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedOrderDetails.StatusText}"
                               Foreground="#255C99"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedOrderDetails.TotalText}"
                               Foreground="#17202B"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="{Binding Path=T[AddProduct]}"
                    Command="{Binding OpenAddOrderProductCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    Margin="0,0,8,0" />
            <Button Content="{Binding Path=T[DeleteProduct]}"
                    Command="{Binding RemoveOrderItemCommand}"
                    Style="{StaticResource ActionButtonStyle}" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#D9E1EA"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Path=T[ProductsInOrder]}"
                               FontWeight="SemiBold"
                               Foreground="#17202B" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding OrderDraftTotalText}"
                               FontWeight="SemiBold"
                               Foreground="#17202B"
                               HorizontalAlignment="Right" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding EditableOrderItems}"
                          SelectedItem="{Binding SelectedOrderItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Path=[Product], Source={x:Static models:LocalizationManager.Instance}}"
                                            Binding="{Binding ProductName}"
                                            IsReadOnly="True"
                                            Width="*" />
                        <DataGridTemplateColumn Header="{Binding Path=[Quantity], Source={x:Static models:LocalizationManager.Instance}}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                             IsReadOnly="{Binding IsQuantityReadOnly}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{Binding Path=[Price], Source={x:Static models:LocalizationManager.Instance}}"
                                            Binding="{Binding UnitPriceText}"
                                            IsReadOnly="True"
                                            Width="120" />
                        <DataGridTextColumn Header="{Binding Path=[Total], Source={x:Static models:LocalizationManager.Instance}}"
                                            Binding="{Binding LineTotalText}"
                                            IsReadOnly="True"
                                            Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{Binding Path=T[Comment]}" Foreground="#687789" />
            <TextBlock Text="{Binding OrderEditCapabilities}" TextWrapping="Wrap" Foreground="#687789" Margin="0,0,0,8" />
            <TextBox IsReadOnly="{Binding IsOrderCommentReadOnly}" Text="{Binding OrderComment, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="70"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="{Binding OrderItemEditorError}"
                       Foreground="#B42318"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasOrderItemEditorError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{Binding Path=T[Cancel]}"
                        Width="110"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click" />
                <Button Content="{Binding Path=T[Save]}"
                        Width="110"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="SaveButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
