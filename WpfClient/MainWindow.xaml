<Window x:Class="WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:WpfClient.Converters"
        xmlns:viewModels="clr-namespace:WpfClient.ViewModels"
        xmlns:views="clr-namespace:WpfClient.Views"
        mc:Ignorable="d"
        Title="Керування замовленнями"
        MinHeight="640"
        MinWidth="980"
        Height="720"
        Width="1120"
        Icon="pack://application:,,,/Assets/app-icon.png"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#D8DEE9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#263241" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#7AA2F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
    </Window.Resources>

    <Grid>
        <views:LoginView Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#17202B">
            <DockPanel Margin="18">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button Command="{Binding SignOutCommand}"
                            Content="Вийти"
                            Width="78"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#263241"
                            Foreground="#FFFFFF"
                            BorderBrush="#3B4754"
                            Cursor="Hand" />
                </Grid>

                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavigationButtonStyle}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="17"
                                               Width="28"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#D9E1EA"
                    BorderThickness="0,0,0,1"
                    Padding="28,20">
                <DockPanel LastChildFill="False">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentTitle}"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Foreground="#17202B" />
                        <TextBlock Text="Тонкий десктопний клієнт для роботи із замовленнями"
                                   Foreground="#687789"
                                   FontSize="14"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding LoadingStatusText}"
                                   Foreground="#8B98A8"
                                   FontSize="12"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border DockPanel.Dock="Right"
                            Background="#EAF2FF"
                            Padding="12,7"
                            CornerRadius="6"
                            VerticalAlignment="Center"
                            Width="250">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentUserName}"
                                       Foreground="#255C99"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentRoleName}"
                                       Foreground="#687789"
                                       FontSize="12"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Padding="28">
                <ContentControl Content="{Binding CurrentView}" />
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
